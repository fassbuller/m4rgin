{
  "expo": {
    "name": "m4rgin",
    "slug": "m4rgin",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf6ee",
    "owner": "fassbullers-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "bundleIdentifier": "de.hennwack.m4rgin",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "m4rgin verbindet sich mit dem KI-Rechner (Ollama) im Laden-WLAN.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "de.hennwack.m4rgin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-hintergrund.png",
        "backgroundColor": "#fbf6ee"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "m4rgin braucht die Kamera, um Barcodes und Titelseiten zu lesen.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "./plugins/cmake-neu.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#fbf6ee"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8ca9cd0f-3043-41a2-8d15-32f0ca9aea2f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8ca9cd0f-3043-41a2-8d15-32f0ca9aea2f"
    }
  }
}
